# Copy to .env and fill in.

# Anthropic API key. Alternatively run `ant auth login` and leave this unset -
# the SDK resolves an OAuth profile automatically.
ANTHROPIC_API_KEY=

# Model. claude-opus-5 is the default and most capable; claude-sonnet-5 is
# faster and cheaper if you are doing lots of routine placement work.
ALTIUM_AGENT_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
ALTIUM_AGENT_EFFORT=high

# Absolute path to the Altium executable, used to wake the bridge headlessly.
ALTIUM_EXE=C:\Program Files\Altium\ADDevelop\X2.EXE

# Bridge working directory. Both the Python daemon and the in-Altium script
# read/write here. Must be on a local disk - NOT inside a OneDrive-synced
# folder, or sync will fight the queue files.
ALTIUM_AGENT_WORKDIR=C:\ProgramData\AltiumAgent\bridge
